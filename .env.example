# Copy this file to .env and fill in the values. Never commit .env.

NODE_ENV=development
PORT=3000

# MySQL / MariaDB. root with an empty password is the XAMPP/Laragon default
# and is fine for local development only. Use a dedicated least-privilege
# account anywhere else (see README).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_jaberkel

# Required. The server refuses to start without it. Must be at least 32
# characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Optional. Comma-separated list of origins allowed to call the API from a
# different domain. Leave empty when the API and frontend share one origin.
CORS_ORIGIN=

# Optional. Number of reverse proxies in front of the app (0 when none).
TRUST_PROXY=0
