          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "schedules"
          ],
          "query": [
            {
              "key": "q",
              "value": "Math"
            }
          ]
        }
      }
    },
    {
      "name": "Student sees published schedules only",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('no drafts', function () { pm.expect(pm.response.json().data.every(function (s) { return s.published === 1; })).to.be.true; });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{viewerToken}}"
