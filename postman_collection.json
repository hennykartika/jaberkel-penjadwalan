{
  "info": {
    "name": "Jaberkel - Schedule Service (Penjadwalan)",
    "_postman_id": "jaberkel-penjadwalan-fp",
    "description": "Koleksi pengujian Schedule Service. Henny Kartika 6026252017. Jalankan 'Login (admin)' lebih dulu agar variabel {{token}} terisi otomatis.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Login (admin) -> simpan token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json.success) { pm.collectionVariables.set('token', json.data.token); }",
              "pm.test('Login berhasil', function () { pm.expect(json.success).to.be.true; });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}" },
        "url": { "raw": "{{baseUrl}}/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "login"] }
      }
    },
    {
      "name": "GET semua jadwal",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{baseUrl}}/v1/schedules", "host": ["{{baseUrl}}"], "path": ["v1", "schedules"] }
      }
    },
    {
      "name": "GET cari jadwal (?q=)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{baseUrl}}/v1/schedules?q=Matematika", "host": ["{{baseUrl}}"], "path": ["v1", "schedules"], "query": [{ "key": "q", "value": "Matematika" }] }
      }
    },
    {
      "name": "POST tambah jadwal (SUKSES)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"subject\": \"Pemrograman Web\",\n  \"teacher\": \"Bu Henny\",\n  \"meeting_link\": \"https://meet.google.com/pemweb-01\",\n  \"day\": \"Jumat\",\n  \"start_time\": \"13:00:00\",\n  \"end_time\": \"15:00:00\"\n}" },
        "url": { "raw": "{{baseUrl}}/v1/schedules", "host": ["{{baseUrl}}"], "path": ["v1", "schedules"] }
      }
    },
    {
      "name": "POST validasi GAGAL (400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"subject\": \"\",\n  \"teacher\": \"Pak Doni\",\n  \"meeting_link\": \"https://meet.google.com/doni\",\n  \"day\": \"Rabu\",\n  \"start_time\": \"10:00:00\",\n  \"end_time\": \"09:00:00\"\n}" },
        "url": { "raw": "{{baseUrl}}/v1/schedules", "host": ["{{baseUrl}}"], "path": ["v1", "schedules"] }
      }
    },
    {
      "name": "POST jadwal BENTROK (409)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"subject\": \"Try Out\",\n  \"teacher\": \"Drs. Bambang Wijaya\",\n  \"meeting_link\": \"https://meet.google.com/tryout\",\n  \"day\": \"Senin\",\n  \"start_time\": \"08:00:00\",\n  \"end_time\": \"09:00:00\"\n}" },
        "url": { "raw": "{{baseUrl}}/v1/schedules", "host": ["{{baseUrl}}"], "path": ["v1", "schedules"] }
      }
    },
    {
      "name": "POST idempotency (anti ganda)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Idempotency-Key", "value": "tambah-jadwal-001" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"subject\": \"Klub Robotik\",\n  \"teacher\": \"Pak Eko\",\n  \"meeting_link\": \"https://meet.google.com/robotik\",\n  \"day\": \"Sabtu\",\n  \"start_time\": \"09:00:00\",\n  \"end_time\": \"11:00:00\"\n}" },
        "url": { "raw": "{{baseUrl}}/v1/schedules", "host": ["{{baseUrl}}"], "path": ["v1", "schedules"] }
      }
    },
    {
      "name": "PUT ubah jadwal",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"subject\": \"Matematika Wajib\",\n  \"teacher\": \"Drs. Bambang Wijaya\",\n  \"meeting_link\": \"https://meet.google.com/mtk-wajib-01\",\n  \"day\": \"Senin\",\n  \"start_time\": \"07:30:00\",\n  \"end_time\": \"09:15:00\"\n}" },
        "url": { "raw": "{{baseUrl}}/v1/schedules/1", "host": ["{{baseUrl}}"], "path": ["v1", "schedules", "1"] }
      }
    },
    {
      "name": "PUT publikasikan jadwal",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{baseUrl}}/v1/schedules/4/publish", "host": ["{{baseUrl}}"], "path": ["v1", "schedules", "4", "publish"] }
      }
    },
    {
      "name": "DELETE hapus jadwal",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{baseUrl}}/v1/schedules/10", "host": ["{{baseUrl}}"], "path": ["v1", "schedules", "10"] }
      }
    },
    {
      "name": "POST tanpa token (403/401) - uji akses",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"subject\": \"Tes\",\n  \"teacher\": \"X\",\n  \"meeting_link\": \"https://meet.google.com/tes\",\n  \"day\": \"Senin\",\n  \"start_time\": \"16:00:00\",\n  \"end_time\": \"17:00:00\"\n}" },
        "url": { "raw": "{{baseUrl}}/v1/schedules", "host": ["{{baseUrl}}"], "path": ["v1", "schedules"] }
      }
    }
  ]
}
